{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch RagGateway",
      "type": "coreclr",
      "request": "launch",
      "requireExactSource": false,
      "preLaunchTask": "Build & Kill Ports - RagGateway",
      "postDebugTask": "Kill Ports - RagGateway",
      "program": "${workspaceFolder}/src/bin/Debug/net9.0/RagGateway.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7200;http://localhost:5200"
      }
    }
  ]
}
