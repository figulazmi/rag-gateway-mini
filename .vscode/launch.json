{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch PetroChina API",
      "type": "coreclr",
      "request": "launch",
      "requireExactSource": false,
      "preLaunchTask": "Build & Kill Ports - API",
      "postDebugTask": "Kill Ports - API",
      "program": "${workspaceFolder}/src/PetroChina.Eproc.API/bin/Debug/net9.0/PetroChina.Eproc.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PetroChina.Eproc.API",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:6100;http://localhost:6200"
      }
    },
    {
      "name": "Launch Internal App",
      "type": "coreclr",
      "request": "launch",
      "requireExactSource": false,
      "preLaunchTask": "Build & Kill Ports - Internal",
      "postDebugTask": "Kill Ports - Internal",
      "program": "${workspaceFolder}/src/Internal/PetroChina.Eproc.Internal.App/bin/Debug/net9.0/PetroChina.Eproc.Internal.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Internal/PetroChina.Eproc.Internal.App",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:6101;http://localhost:6201"
      }
    },
    {
      "name": "Launch External App",
      "type": "coreclr",
      "request": "launch",
      "requireExactSource": false,
      "preLaunchTask": "Build & Kill Ports - External",
      "postDebugTask": "Kill Ports - External",
      "program": "${workspaceFolder}/src/External/PetroChina.Eproc.External.App/bin/Debug/net9.0/PetroChina.Eproc.External.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/External/PetroChina.Eproc.External.App",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:6102;http://localhost:6202"
      }
    }
  ]
}
