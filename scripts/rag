#!/usr/bin/env bash
# =============================================================================
# rag
# Author  : Figur Ulul Azmi
# Target  : RAG Gateway Mini API
# Usage   : rag "query" [-p project] [--claude [task]] [--strict] [--debug] [--raw] [--copy]
#
# RAG_BASE_URL resolution order:
#   1. RAG_BASE_URL env var (export RAG_BASE_URL=http://... in shell)
#   2. ~/.config/rag-gateway.env (written by install.sh)
#   3. Auto-detect: localhost:5200 -> LAN 192.168.18.199:5200 -> Tailscale 100.120.249.99:5200
#
# Output modes:
#   (default)      // RAG_CONTEXT: comment blocks (for Copilot)
#   --claude       Structured Claude prompt grounded in RAG context
#   --raw          Plain content, no formatting
#   --debug        /rag/debug endpoint (scores, threshold, raw counts)
#
# Smart features:
#   Intent auto-detection: query with design/implement/architecture keywords
#                          auto-switches to --claude mode
#   --strict         Adds zero-hallucination constraint to Claude prompt
#   --show-scores    Show [score: X.XX] per SOURCE in Claude mode
#   --copy           Copy output to clipboard (clip.exe / xclip)
#
# Examples:
#   rag "SDL session kicked detection" -p petrochina-eproc
#   rag "design single device login" -p petrochina-eproc
#   rag "implement hangfire retry policy" --claude "write the handler" --strict
#   rag "qdrant setup VM B1" -p homelab --raw
# =============================================================================

set -euo pipefail

# =============================================================================
# CONFIG — RAG_BASE_URL resolution
# Priority: (1) env var  (2) ~/.config/rag-gateway.env  (3) auto-detect
# =============================================================================

_detect_rag_url() {
  # localhost first (local dev or running directly on VM B1)
  curl -s --connect-timeout 1 "http://localhost:5200/health" -o /dev/null 2>/dev/null \
    && echo "http://localhost:5200" && return
  # LAN (office network)
  curl -s --connect-timeout 2 "http://192.168.18.199:5200/health" -o /dev/null 2>/dev/null \
    && echo "http://192.168.18.199:5200" && return
  # Tailscale (remote / outside office)
  curl -s --connect-timeout 3 "http://100.120.249.99:5200/health" -o /dev/null 2>/dev/null \
    && echo "http://100.120.249.99:5200" && return
  echo ""
}

_RAG_ENV_FILE="$HOME/.config/rag-gateway.env"
# shellcheck source=/dev/null
[ -f "$_RAG_ENV_FILE" ] && source "$_RAG_ENV_FILE"

if [ -z "${RAG_BASE_URL:-}" ]; then
  RAG_BASE_URL=$(_detect_rag_url)
  if [ -z "$RAG_BASE_URL" ]; then
    echo "Error: cannot reach RAG Gateway via localhost, LAN (192.168.18.199), or Tailscale (100.120.249.99)." >&2
    echo "Override: export RAG_BASE_URL=http://<host>:5200" >&2
    exit 1
  fi
fi

RAG_SEARCH_ENDPOINT="${RAG_BASE_URL}/rag/search"
RAG_DEBUG_ENDPOINT="${RAG_BASE_URL}/rag/debug"

# Keywords that auto-trigger Claude mode (reasoning tasks)
CLAUDE_TRIGGER_WORDS="design|architecture|implement|system|flow|strategy|pattern|explain|how does|why does|compare|decide|evaluate|plan|structure"

# =============================================================================
# ARGUMENT PARSING
# =============================================================================

QUERY=""
PROJECT=""
USE_DEBUG=false
RAW_OUTPUT=false
COPY_OUTPUT=false
CLAUDE_MODE=false
CLAUDE_TASK=""
STRICT_MODE=false
SHOW_SCORES=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--project)
      PROJECT="$2"
      shift 2
      ;;
    --debug)
      USE_DEBUG=true
      shift
      ;;
    --raw)
      RAW_OUTPUT=true
      shift
      ;;
    --copy)
      COPY_OUTPUT=true
      shift
      ;;
    --claude)
      CLAUDE_MODE=true
      if [[ $# -gt 1 && "${2:0:1}" != "-" ]]; then
        CLAUDE_TASK="$2"
        shift 2
      else
        shift
      fi
      ;;
    --strict)
      STRICT_MODE=true
      shift
      ;;
    --show-scores)
      SHOW_SCORES=true
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Usage: rag "query" [-p project] [--claude [task]] [--strict] [--show-scores] [--debug] [--raw] [--copy]

Output modes:
  (default)        // RAG_CONTEXT: comment blocks  -> paste into .cs for Copilot
  --claude [task]  Structured Claude prompt        -> paste into Claude chat
  --raw            Plain content, no formatting
  --debug          /rag/debug endpoint (scores, threshold, raw counts)

Options:
  -p, --project    Filter by project (petrochina-eproc | homelab)
  --strict         Add zero-hallucination enforcement to Claude prompt
  --show-scores    Show relevance scores per SOURCE in Claude mode
  --copy           Copy output to clipboard
  -h, --help       Show this help

RAG_BASE_URL is resolved from (in order):
  1. RAG_BASE_URL env var
  2. ~/.config/rag-gateway.env
  3. http://192.168.18.199:5200 (VM B1 LAN fallback)

Smart: queries containing design/implement/architecture/system/flow/explain
       are automatically routed to --claude mode. No flag needed.

Examples:
  rag "SDL session kicked detection" -p petrochina-eproc
  rag "design single device login" -p petrochina-eproc
  rag "implement hangfire retry policy" --claude "write the MediatR handler" --strict
  rag "qdrant setup VM B1" -p homelab --raw
EOF
      exit 0
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$QUERY" ]]; then
        QUERY="$1"
      else
        echo "Error: unexpected argument '$1'" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$QUERY" ]]; then
  echo "Error: query is required." >&2
  echo "Usage: rag \"your query here\"" >&2
  exit 1
fi

# =============================================================================
# INTENT AUTO-DETECTION
# =============================================================================

detect_intent() {
  local q="${1,,}"
  if [[ "$q" =~ ($CLAUDE_TRIGGER_WORDS) ]]; then
    CLAUDE_MODE=true
    echo "[rag] Intent detected: routing to Claude mode" >&2
  fi
}

if [[ "$CLAUDE_MODE" == false && "$RAW_OUTPUT" == false && "$USE_DEBUG" == false ]]; then
  detect_intent "$QUERY"
fi

# =============================================================================
# CHECK DEPENDENCIES
# =============================================================================

if ! command -v curl &>/dev/null; then
  echo "Error: curl is not installed." >&2
  exit 1
fi

if ! command -v jq &>/dev/null; then
  echo "Error: jq is not installed." >&2
  echo "  Windows: winget install jqlang.jq" >&2
  echo "  Linux:   sudo apt install jq" >&2
  echo "  Mac:     brew install jq" >&2
  exit 1
fi

# =============================================================================
# BUILD JSON PAYLOAD
# =============================================================================

if [[ -n "$PROJECT" ]]; then
  PAYLOAD=$(jq -n --arg q "$QUERY" --arg p "$PROJECT" '{"query": $q, "project": $p}')
else
  PAYLOAD=$(jq -n --arg q "$QUERY" '{"query": $q}')
fi

# =============================================================================
# SELECT ENDPOINT
# =============================================================================

if [[ "$USE_DEBUG" == true ]]; then
  ENDPOINT="$RAG_DEBUG_ENDPOINT"
else
  ENDPOINT="$RAG_SEARCH_ENDPOINT"
fi

# =============================================================================
# CALL RAG GATEWAY
# =============================================================================

RESPONSE=$(curl -s \
  --connect-timeout 5 \
  --max-time 30 \
  -X POST "$ENDPOINT" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" 2>/dev/null) || {
  echo "Error: could not connect to RAG Gateway at ${RAG_BASE_URL}" >&2
  echo "Check: is VM B1 reachable? RAG_BASE_URL=${RAG_BASE_URL}" >&2
  echo "Override: export RAG_BASE_URL=http://<host>:5200" >&2
  exit 1
}

if [[ -z "$RESPONSE" ]]; then
  echo "Error: empty response from RAG Gateway." >&2
  exit 1
fi

# =============================================================================
# HELPERS
# =============================================================================

not_found_output() {
  if [[ "$CLAUDE_MODE" == true ]]; then
    printf "NOT FOUND IN KNOWLEDGE BASE\nQuery: \"%s\"\n\nCannot generate Claude prompt without RAG context.\n" "$QUERY"
  elif [[ "$RAW_OUTPUT" == true ]]; then
    printf "NOT FOUND IN KNOWLEDGE BASE for query: \"%s\"\n" "$QUERY"
  else
    printf "// RAG: NOT FOUND IN KNOWLEDGE BASE\n// Query: \"%s\"\n" "$QUERY"
  fi
}

infer_task() {
  local q="${1,,}"
  if [[ "$q" =~ ^design ]]; then
    echo "Design the system described in the RAG context above"
  elif [[ "$q" =~ ^implement ]]; then
    echo "Implement the feature described in the RAG context above"
  elif [[ "$q" =~ ^explain|^how|^why ]]; then
    echo "Explain how this works based strictly on the RAG context above"
  elif [[ "$q" =~ ^compare|^evaluate|^decide ]]; then
    echo "Compare and evaluate the options described in the RAG context above"
  else
    echo "Answer the following based strictly on the RAG context above: ${1}"
  fi
}

copy_to_clipboard() {
  local text="$1"
  if command -v clip.exe &>/dev/null; then
    printf "%s" "$text" | clip.exe
  elif command -v xclip &>/dev/null; then
    printf "%s" "$text" | xclip -selection clipboard
  elif command -v pbcopy &>/dev/null; then
    printf "%s" "$text" | pbcopy
  else
    echo "Warning: no clipboard tool found (clip.exe / xclip / pbcopy)" >&2
    return 1
  fi
}

# =============================================================================
# FORMAT OUTPUT
# =============================================================================

format_output() {
  local response="$1"

  if [[ "$USE_DEBUG" == true ]]; then
    echo "$response" | jq '.'
    return
  fi

  local status
  status=$(echo "$response" | jq -r '.status // "error"')

  if [[ "$status" == "not_found" ]]; then
    not_found_output
    return
  fi

  if [[ "$status" == "error" ]]; then
    local err_msg
    err_msg=$(echo "$response" | jq -r '.error // "Unknown error"')
    echo "Error from RAG Gateway: ${err_msg}" >&2
    exit 1
  fi

  local result_count
  result_count=$(echo "$response" | jq '.results | length')

  if [[ "$result_count" -eq 0 ]]; then
    not_found_output
    return
  fi

  # Claude prompt mode
  if [[ "$CLAUDE_MODE" == true ]]; then
    local task_line
    if [[ -n "$CLAUDE_TASK" ]]; then
      task_line="$CLAUDE_TASK"
    else
      task_line=$(infer_task "$QUERY")
    fi

    printf "You MUST ONLY use the following RAG context to answer.\n"
    printf "Do NOT use external knowledge or assumptions.\n"
    printf "If the required information is missing from the context, say: NOT FOUND IN RAG\n"
    printf "\n"
    printf "════════════════════════════════════════\n"
    printf "RAG CONTEXT  |  source: Qdrant knowledge base\n"
    printf "Query  : \"%s\"\n" "$QUERY"
    [[ -n "$PROJECT" ]] && printf "Project: %s\n" "$PROJECT"
    printf "════════════════════════════════════════\n"
    printf "\n"

    local idx=1
    while IFS= read -r result; do
      local score content score_fmt
      score=$(echo "$result" | jq -r '.score')
      content=$(echo "$result" | jq -r '.content')
      score_fmt=$(printf "%.2f" "$score")

      if [[ "$SHOW_SCORES" == true ]]; then
        printf "SOURCE %d  [relevance: %s]\n" "$idx" "$score_fmt"
      else
        printf "SOURCE %d\n" "$idx"
      fi
      printf "────────────────────────────────────────\n"
      printf "%s\n" "$content"
      printf "\n"
      ((idx++))
    done < <(echo "$response" | jq -c '.results[]')

    printf "════════════════════════════════════════\n"
    printf "TASK\n"
    printf "════════════════════════════════════════\n"
    printf "\n"
    printf "%s\n" "$task_line"
    printf "\n"
    printf "════════════════════════════════════════\n"
    printf "CONSTRAINTS\n"
    printf "════════════════════════════════════════\n"
    printf "\n"
    printf "- Base your answer ONLY on the RAG context above\n"
    printf "- Do NOT hallucinate or assume missing details\n"
    printf "- If context is insufficient, explicitly state what is missing\n"
    printf "- Keep response concise and actionable\n"

    if [[ "$STRICT_MODE" == true ]]; then
      printf "\n"
      printf "STRICT MODE -- ZERO HALLUCINATION ENFORCEMENT\n"
      printf "────────────────────────────────────────\n"
      printf "- Every claim you make MUST be traceable to a SOURCE above\n"
      printf "- For each key statement, cite the source: (SOURCE N)\n"
      printf "- If ANY part cannot be supported by the sources, output:\n"
      printf "  NOT FOUND IN RAG: [describe what is missing]\n"
      printf "- Do NOT proceed with assumptions under any circumstances\n"
    fi
    return
  fi

  # Raw mode
  if [[ "$RAW_OUTPUT" == true ]]; then
    local first=true
    while IFS= read -r result; do
      local content
      content=$(echo "$result" | jq -r '.content')
      [[ "$first" == false ]] && printf "\n\n---\n\n"
      printf "%s" "$content"
      first=false
    done < <(echo "$response" | jq -c '.results[]')
    printf "\n"
    return
  fi

  # Default: Copilot comment blocks
  local output=""
  local first=true

  while IFS= read -r result; do
    local score content score_fmt
    score=$(echo "$result" | jq -r '.score')
    content=$(echo "$result" | jq -r '.content')
    score_fmt=$(printf "%.2f" "$score")

    [[ "$first" == false ]] && output+="\n//\n"
    output+="// RAG_CONTEXT [score: ${score_fmt}]:\n"

    while IFS= read -r line; do
      if [[ -z "$line" ]]; then
        output+="//\n"
      else
        output+="// ${line}\n"
      fi
    done <<< "$content"

    first=false
  done < <(echo "$response" | jq -c '.results[]')

  printf "%b" "$output"
}

# =============================================================================
# OUTPUT
# =============================================================================

FORMATTED=$(format_output "$RESPONSE")

if [[ "$COPY_OUTPUT" == true ]]; then
  if copy_to_clipboard "$FORMATTED"; then
    echo "Copied to clipboard." >&2
  fi
fi

printf "%s\n" "$FORMATTED"
