# claude-mcp-connect.ps1
# Copy ke: ~/.claude/claude-mcp-connect.ps1
# Edit: B1_LOCAL_IP, B1_TAILSCALE_IP, USER sesuai setup kamu

$B1_LOCAL_IP     = "192.168.18.199"
$B1_TAILSCALE_IP = "100.120.249.99"
$USER            = "figulazmi"
$MCP_CMD         = "set -a; . ~/.qdrant-mcp.env; set +a; node /opt/mcp-servers/qdrant-knowledge/qdrant-mcp-server.js"

# Try LAN first, fallback to Tailscale
ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=3 "${USER}@${B1_LOCAL_IP}" $MCP_CMD
if ($LASTEXITCODE -eq 0) { exit 0 }

ssh -o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=5 "${USER}@${B1_TAILSCALE_IP}" $MCP_CMD
if ($LASTEXITCODE -eq 0) { exit 0 }

Write-Error "Cannot reach VM B1 via LAN or Tailscale"
exit 1
