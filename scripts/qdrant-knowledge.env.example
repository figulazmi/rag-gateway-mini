# =============================================================================
# qdrant-knowledge.env.example
# Template konfigurasi untuk RAG Knowledge Pipeline
#
# CARA PAKAI:
#   1. Copy file ini ke luar repo: cp scripts/qdrant-knowledge.env.example ~/.config/qdrant-knowledge.env
#   2. Edit file tersebut, ganti "your-api-key-here" dengan nilai asli
#   3. File ~/.config/qdrant-knowledge.env TIDAK boleh di-commit ke git
#
# Dapatkan nilai QDRANT_API_KEY dari:
#   - Tanya Azmi, ATAU
#   - SSH ke VM B1 → cat /opt/homelab/ai-stack/.env | grep QDRANT_API_KEY
# =============================================================================

QDRANT_API_KEY=your-api-key-here
