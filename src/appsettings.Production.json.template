{
  "RagGateway": {
    "OllamaBaseUrl": "http://192.168.18.199:11434",
    "QdrantBaseUrl": "http://192.168.18.199:6333",
    "OllamaModel": "nomic-embed-text",
    "QdrantCollection": "knowledge_v2",
    "QdrantApiKey": "FILL_WITH_REAL_KEY",
    "ScoreThreshold": 0.35,
    "ResultLimit": 5,
