{
  "RagGateway": {
    "OllamaBaseUrl": "http://192.168.18.169:11434",
    "QdrantBaseUrl": "http://192.168.18.169:6333",
    "OllamaModel": "nomic-embed-text",
    "QdrantCollection": "knowledge_v2",
    "QdrantApiKey": "",
    "ScoreThreshold": 0.35,
    "ResultLimit": 5,
    "DenseVectorName": "dense",
    "SparseVectorName": "sparse",
    "EnableHybridSearch": true,
    "HybridPrefetchLimit": 20,
    "FusionMethod": "rrf",
    "SparseInferenceModel": "Qdrant/bm25"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://192.168.18.169:5341"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },
  "AllowedHosts": "*"
}
